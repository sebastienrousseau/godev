# langdev — example environment. Copy to `.env` (which is gitignored AND
# dockerignored) and fill in. NEVER put real secrets in THIS file.
#
# The .env is loaded at RUNTIME only (compose `env_file`). It is never
# committed and never COPY'd into an image layer.

# Image naming (optional).
#IMAGE=godev
#TAG=local

# Timezone for the container.
TZ=UTC

# --- Secrets (examples — placeholders only) ----------------------------------
# Provide real values only in your local .env, or via your secret manager.
# godev needs no secrets to build or run; the toolchain is baked in.
#GOPROXY=https://proxy.golang.org,direct   # override the module proxy
#GOPRIVATE=example.com/org/*               # bypass the proxy for private modules
#GITHUB_TOKEN=replace-me                    # only if you fetch private modules
